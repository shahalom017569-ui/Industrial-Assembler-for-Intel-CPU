#include "assembler.h"
#include "target.h"

const target_backend *target_find(cpu_target target);

static const target_backend backend = {
    TARGET_X86_64,
    "x86_64",
    64,
    64,
    1,
    NULL,
    NULL
};

const target_backend *target_find(cpu_target target) {
    if (target == TARGET_X86_64) {
        return &backend;
    }
    return NULL;
}
